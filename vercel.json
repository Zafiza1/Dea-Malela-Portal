{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "regions": [
        "hnd1"
    ],
    "rewrites": [
        {
            "source": "/test",
            "destination": "/api/index.php"
        },
        {
            "source": "/build/assets/(.*)",
            "destination": "/public/build/assets/$1"
        },
        {
            "source": "/assets/(.*)",
            "destination": "/public/build/assets/$1"
        },
        {
            "source": "/images/(.*)",
            "destination": "/public/images/$1"
        },
        {
            "source": "/favicon.(.*)",
            "destination": "/public/favicon.$1"
        },
        {
            "source": "/apple-touch-icon.png",
            "destination": "/public/apple-touch-icon.png"
        },
        {
            "source": "/robots.txt",
            "destination": "/public/robots.txt"
        },
        {
            "source": "/(.*)",
            "destination": "/public/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Pesantren Modern Internasional Dea Malela",
        "APP_ENV": "production",
        "APP_KEY": "base64:UtSqw+NLM6VSDGmvSeXSqlvFs0y2WowhYVI0HhHo6tI=",
        "APP_DEBUG": "false",
        "APP_URL": "https://dea-malela-portal-tau.vercel.app",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "CACHE_DRIVER": "array",
        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "SESSION_DRIVER": "cookie",
        "SESSION_SAME_SITE": "lax",
        "SESSION_SECURE_COOKIE": "true",
        "SESSION_LIFETIME": "480",
        "VIEW_COMPILED_PATH": "/tmp",
