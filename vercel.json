{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "builds": [
        {
            "src": "/api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/build/assets/(.*)",
            "dest": "/public/build/assets/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/public/build/assets/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/$1"
        },
        {
            "src": "/favicon.(.*)",
            "dest": "/public/favicon.$1"
        },
        {
            "src": "/apple-touch-icon.png",
            "dest": "/public/apple-touch-icon.png"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "APP_DEBUG": "true",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "aws-0-ap-south-1.pooler.supabase.com",
        "DB_PORT": "6543",
        "DB_DATABASE": "postgres",
        "DB_USERNAME": "postgres.wzlhobpewqaxbucoafdl",
        "DB_PASSWORD": "deamalela@123",
        "DB_SSLMODE": "require",
        "PGHOST": "aws-0-ap-south-1.pooler.supabase.com",
        "PGDATABASE": "postgres",
        "PGUSER": "postgres.wzlhobpewqaxbucoafdl",
        "PGPASSWORD": "deamalela@123"
    },
    "installCommand": "composer install --no-dev --optimize-autoloader",
    "buildCommand": "npm run build && php artisan migrate --force && php artisan db:seed --force"
}