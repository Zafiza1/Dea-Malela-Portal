# ============================================================
# Template .env untuk deploy di cPanel (domain: deamalelaportal.my.id)
# Salin ke .env lalu isi nilai yang ditandai <ISI_...>
#   cp .env.production.example .env
#   php artisan key:generate
# ============================================================

APP_NAME="Pesantren Modern Internasional Dea Malela"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://deamalelaportal.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---- Database: MariaDB cPanel ----
# Server: MariaDB 10.11 (Localhost via UNIX socket).
# Buat DB + user BARU di cPanel > "MySQL Databases" (JANGAN pakai user cpses_xxx
# yang muncul di phpMyAdmin - itu cuma sesi login sementara).
# Nama akan berformat: cpaneluser_namadb  /  cpaneluser_dbuser
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<ISI_NAMA_DATABASE>
DB_USERNAME=<ISI_USER_DATABASE>
DB_PASSWORD=<ISI_PASSWORD_DATABASE>
# Kalau "localhost" gagal konek, ganti DB_HOST=127.0.0.1
# atau tambahkan: DB_SOCKET=/var/lib/mysql/mysql.sock

# ---- Session / Cache / Queue ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ---- Penyimpanan file: pakai disk lokal (folder storage/app/public) ----
FILESYSTEM_DISK=public

# ---- Email (isi sesuai akun email cPanel bila perlu kirim email) ----
MAIL_MAILER=smtp
MAIL_HOST=mail.deamalelaportal.my.id
MAIL_PORT=465
MAIL_USERNAME=<ISI_EMAIL>
MAIL_PASSWORD=<ISI_PASSWORD_EMAIL>
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="admin@deamalelaportal.my.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
ASSET_URL=https://deamalelaportal.my.id
