{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "builds": [
        {
            "src": "/api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/storage/0",
            "status": 404
        },
        {
            "src": "/storage/null",
            "status": 404
        },
        {
            "src": "/build/assets/(.*)",
            "dest": "/public/build/assets/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/public/build/assets/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/$1"
        },
        {
            "src": "/favicon.(.*)",
            "dest": "/public/favicon.$1"
        },
        {
            "src": "/apple-touch-icon.png",
            "dest": "/public/apple-touch-icon.png"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "APP_DEBUG": "true",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "db.wzlhobpewqaxbucoafdl.supabase.co",
        "DB_PORT": "5432",
        "DB_DATABASE": "postgres",
        "DB_USERNAME": "postgres",
        "DB_PASSWORD": "deamalela@123",
        "DB_SSLMODE": "require",
        "FILESYSTEM_DISK": "supabase",
        "SUPABASE_STORAGE_REGION": "ap-south-1",
        "SUPABASE_STORAGE_BUCKET": "guru-files",
        "SUPABASE_STORAGE_PUBLIC_URL": "https://wzlhobpewqaxbucoafdl.supabase.co/storage/v1/object/public",
        "SUPABASE_STORAGE_ENDPOINT": "https://wzlhobpewqaxbucoafdl.storage.supabase.co/storage/v1/s3",
        "SESSION_LIFETIME": "480",
        "SESSION_DRIVER": "cookie",
        "SESSION_SAME_SITE": "none",
        "SESSION_SECURE_COOKIE": "true"
    },
    "installCommand": "composer install --no-dev --optimize-autoloader",
    "buildCommand": "php artisan config:clear && php artisan cache:clear && npm run build"
}