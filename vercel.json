{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": null,
    "installCommand": null,
    "outputDirectory": null,
    "builds": [
        {
            "src": "public/index.php",
            "use": "vercel-php@0.8.0"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/public/index.php"
        }
    ]
}